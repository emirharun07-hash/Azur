{%- comment -%}
  Rechteckige Größenauswahl als Radiogruppe (Formularfeld "id" = Varianten-ID).
  Ausverkaufte Größen sind sichtbar, durchgestrichen und nicht wählbar.
  Größentabelle aus der Theme-Einstellung "Größentabelle" (Größe | Brustbreite | Länge): Link rechts neben der
  Legende, öffnet ein Popover (ohne JavaScript, schließt mit Esc oder Klick daneben). Leer = kein Link (Hinweis nur im Theme-Editor).
  Parameter: product, form_id
{%- endcomment -%}
{%- liquid
  assign option_name = 'azur.cart.size' | t
  assign chart_id = form_id | append: '-chart'
  assign chart_rows = settings.size_chart | strip | newline_to_br | split: '<br />'
-%}
{%- comment -%}
  P3: knapper Bestand (1–3, nur Flag, keine Zahl): kleiner Punkt am Knopf und, wenn die Größe gewählt ist, die Zeile
  „Größe M: nur noch wenige“ unter der Auswahl (nur CSS, über :has).
{%- endcomment -%}
<style>
  .sizes__lowline { display: none; margin: var(--s-2, 0.5rem) 0 0; font-size: 0.75rem; color: var(--c-grey-text); }
  .sizes__low { position: absolute; top: 0.35rem; right: 0.35rem; width: 0.375rem; height: 0.375rem; border-radius: 50%; background: currentColor; opacity: 0.55; pointer-events: none; }
  .sizes__row .size { position: relative; }
</style>
<fieldset class="sizes" data-sizes-picker>
  <legend class="sizes__legend">
    <span>{{ option_name }}</span>
    <span class="sizes__picked" data-size-picked aria-hidden="true"></span>
  </legend>
  {%- if settings.size_chart != blank -%}
    <button class="sizes__chart link" type="button" popovertarget="{{ chart_id }}">{{ 'azur.product.size_chart' | t }}</button>
  {%- elsif request.design_mode -%}
    <span class="sizes__chart">{% render 'placeholder', text: 'Größentabelle fehlt' %}</span>
  {%- endif -%}
  <div class="sizes__row" style="--n: {{ product.variants.size | at_most: 6 }}">
    {%- for variant in product.variants -%}
      {%- assign vid = form_id | append: '-' | append: variant.id -%}
      <input class="sizes__input sr-only" type="radio" name="id" id="{{ vid }}" value="{{ variant.id }}"
        data-size="{{ variant.option1 | escape }}" data-price="{{ variant.price }}"
        {%- if forloop.first %} required{% endif -%}
        {%- unless variant.available %} disabled{% endunless -%}
        {%- if product.selected_variant and variant.id == product.selected_variant.id and variant.available %} checked{% endif %}>
      {%- assign low = false -%}
      {%- if variant.available and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 3 -%}{%- assign low = true -%}{%- endif -%}
      <label class="size" for="{{ vid }}"{% unless variant.available %} data-soldout{% endunless %}{% if low %} data-low{% endif %}>
        {{- variant.option1 -}}
        {%- unless variant.available %}<span class="sr-only">{{ 'azur.general.sold_out_sr' | t }}</span>{% endunless -%}
        {%- if low %}<span class="sizes__low" role="img" aria-label="{{ 'azur.product.low_few' | t }}"></span>{% endif -%}
      </label>
    {%- endfor -%}
  </div>
  {%- for variant in product.variants -%}
    {%- if variant.available and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 3 -%}
      {%- assign vid = form_id | append: '-' | append: variant.id -%}
      <style>.sizes:has(#{{ vid }}:checked) #{{ vid }}-low { display: block; }</style>
      <p class="sizes__lowline" id="{{ vid }}-low">{{ 'azur.product.low_line' | t: size: variant.option1 }}</p>
    {%- endif -%}
  {%- endfor -%}
</fieldset>

{%- if settings.size_chart != blank -%}
  <div class="chart" id="{{ chart_id }}" popover role="dialog" aria-labelledby="{{ chart_id }}-title">
    <div class="chart__head">
      <h2 class="chart__title" id="{{ chart_id }}-title">{{ 'azur.product.size_chart' | t }}</h2>
      <button class="chart__close" type="button" popovertarget="{{ chart_id }}" popovertargetaction="hide">{{ 'azur.general.close' | t }}</button>
    </div>
    <table class="chart__table">
      <thead>
        <tr><th scope="col">{{ option_name }}</th><th scope="col">{{ 'azur.product.chest' | t }}</th><th scope="col">{{ 'azur.product.length' | t }}</th></tr>
      </thead>
      <tbody>
        {%- for row in chart_rows -%}
          {%- assign cells = row | strip | split: '|' -%}
          {%- if cells.size < 2 -%}{%- continue -%}{%- endif -%}
          <tr>
            <th scope="row">{{ cells[0] | strip }}</th>
            <td>{{ cells[1] | remove: 'cm' | strip }}</td>
            <td>{{ cells[2] | remove: 'cm' | strip }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
{%- endif -%}

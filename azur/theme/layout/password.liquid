<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#121212">
  {%- assign title = settings.seo_home_title | default: shop.name %}
  <title>{{ title }}</title>
  {%- if settings.seo_home_description != blank %}
    <meta name="description" content="{{ settings.seo_home_description | escape }}">
  {%- endif %}
  {%- render 'head-icons' %}
  {%- render 'social-meta', title: title, description: settings.seo_home_description %}
  <link rel="preload" href="{{ 'archivo-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <style>
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 100 900;
      font-stretch: 62% 125%;
      font-display: swap;
      src: url("{{ 'archivo-latin.woff2' | asset_url }}") format("woff2");
    }
  </style>
  {{ 'azur.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="inhalt">
    {{ content_for_layout }}
  </main>
</body>
</html>

<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f3f0ea">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- render 'head-icons' %}
  {%- liquid
    # Startseite: Titel und Beschreibung aus Onlineshop → Einstellungen; ohne Eintrag die Theme-Einstellungen
    assign title = page_title
    assign description = page_description
    if template.name == 'index'
      if page_title == shop.name and settings.seo_home_title != blank
        assign title = settings.seo_home_title
      endif
      if description == blank
        assign description = settings.seo_home_description
      endif
    endif
  -%}
  <title>
    {{- title -}}
    {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page and current_page != 1 %} – Seite {{ current_page }}{% endif -%}
    {%- unless title contains shop.name %} — {{ shop.name }}{% endunless -%}
  </title>
  {%- if description != blank %}
    <meta name="description" content="{{ description | escape }}">
  {%- endif %}
  {%- render 'social-meta', title: title, description: description %}

  <link rel="preload" href="{{ 'archivo-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <style>
    /* Archivo, variabel (wght 100–900, wdth 62–125 %), selbst gehostet. SIL Open Font License 1.1.
       Eine Familie: schmal (62 %) für Headlines, normal breit für Text. */
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 100 900;
      font-stretch: 62% 125%;
      font-display: swap;
      src: url("{{ 'archivo-latin.woff2' | asset_url }}") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 100 900;
      font-stretch: 62% 125%;
      font-display: swap;
      src: url("{{ 'archivo-latin-ext.woff2' | asset_url }}") format("woff2");
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
  </style>
  <script>document.documentElement.className = 'js';</script>
  {{ 'azur.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

  {% section 'announcement' %}
  {% section 'header' %}

  <main id="inhalt" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% section 'cart-drawer' %}

  <script src="{{ 'azur.js' | asset_url }}" defer></script>
  {% render 'azur-admin' %}
</body>
</html>

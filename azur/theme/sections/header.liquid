{%- comment -%}
  Header (Runde 13, schlicht nach yeezy.com): links klein das Logo (führt zur Startseite), in der Mitte nur zwei Wörter,
  STADT (Städtetrikots) und LAND (Nationaltrikots), rechts die Sporttasche als Warenkorb. Ist eine der beiden Seiten
  gewählt (Kollektion oder ein Trikot daraus), steht sie schwarz und die andere hellgrau.
  Support, Konto und alle Rechtsseiten stehen im Footer.
  Startseite: liegt durchsichtig mit heller Schrift über dem Zimmer, bis das Zimmer nach oben weggescrollt ist.
{%- endcomment -%}
{%- liquid
  assign city = section.settings.city
  if city.url == blank
    assign city = collections['staedtetrikots']
  endif
  assign land = section.settings.land
  if land.url == blank
    assign land = settings.nav_collection
  endif
  if land.url == blank
    assign land = collections['nationaltrikots']
  endif

  assign on_city = false
  assign on_land = false
  if collection.handle != blank
    if collection.handle == city.handle
      assign on_city = true
    elsif collection.handle == land.handle
      assign on_land = true
    endif
  elsif product
    for c in product.collections
      if c.handle == city.handle
        assign on_city = true
      elsif c.handle == land.handle
        assign on_land = true
      endif
    endfor
  endif

  assign overlay = false
  if template.name == 'index'
    assign overlay = true
  endif
-%}
<header class="header{% if overlay %} header--overlay{% endif %}" data-header>
  <div class="header__bar wrap">
    <a class="header__logo" href="{{ routes.root_url }}">
      {%- comment -%} beide Signaturen; welche sichtbar ist, entscheidet die Palette (azur.css, --logo-ink / --logo-paper) {%- endcomment -%}
      {%- render 'logo', tone: 'ink', eager: true, class: 'logo--ink' -%}
      {%- render 'logo', tone: 'paper', eager: true, class: 'logo--paper' -%}
      <span class="sr-only">Startseite</span>
    </a>

    <nav class="header__cats" aria-label="Trikots">
      {%- if city.url != blank -%}
        <a class="header__cat" href="{{ city.url }}"{% if on_city %} aria-current="page"{% endif %}>Stadt</a>
      {%- endif -%}
      {%- if land.url != blank -%}
        <a class="header__cat" href="{{ land.url }}"{% if on_land %} aria-current="page"{% endif %}>Land</a>
      {%- endif -%}
    </nav>

    <div class="header__end">
      <a class="header__icon header__cart" href="{{ routes.cart_url }}" data-cart-open aria-haspopup="dialog">
        {%- comment -%} die Sporttasche aus dem Zimmer ist das eine Warenkorb-Symbol auf allen Seiten {%- endcomment -%}
        <svg class="sportbag" viewBox="0 0 48 40" width="48" height="40" aria-hidden="true" focusable="false"><path class="sportbag__strap" d="M15 14 C15 5 33 5 33 14"/><rect class="sportbag__body" x="4" y="13" width="40" height="22" rx="10"/><path class="sportbag__stripe" d="M5 24 H43"/><circle class="sportbag__ball" cx="35" cy="24" r="5.2"/><path class="sportbag__lines" d="M35 19.6 l3 2.4 -1.2 3.6 h-3.6 l-1.2-3.6z"/></svg>
        <span class="sr-only">Warenkorb,</span>
        <span class="header__count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        <span class="sr-only">Artikel</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "collection", "id": "city", "label": "STADT führt zu", "info": "Leer = Kollektion „Städtetrikots“." },
    { "type": "collection", "id": "land", "label": "LAND führt zu", "info": "Leer = Kategorie aus den Theme-Einstellungen (Nationaltrikots)." }
  ]
}
{% endschema %}

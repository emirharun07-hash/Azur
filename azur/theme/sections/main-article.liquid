<article class="legal wrap">
  <aside class="legal__side">
    <p><a class="link" href="{{ blog.url }}">{{ blog.title | escape }}</a></p>
    <p class="legal__side-head">{{ article.published_at | date: '%d.%m.%Y' }}</p>
  </aside>
  <div class="legal__body">
    <h1 class="page-title">{{ article.title | escape }}</h1>
    {%- if article.image -%}
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', sizes: '(min-width: 1024px) 66vw, 100vw' }}
    {%- endif -%}
    <div class="legal__text rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Beitrag",
  "settings": []
}
{% endschema %}

{%- comment -%}
  Passwortseite, solange der Shop geschlossen ist: "Das Zimmer ist noch dunkel". Dunkler Raum, Logo gedimmt (Neon aus),
  der Wecker bis zum Start ist die einzige helle Stelle. Darunter die Anmeldung für Drops (E-Mail, Tag early-access) und
  aufklappbar die Passworteingabe. Ohne gültiges Startdatum (launch_at) oder bei einem Datum in der Vergangenheit
  erscheint kein Wecker. Ein Teaser-Bild gibt es nur, wenn eines gewählt ist.
{%- endcomment -%}
{{ 'azur-password.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign launch_at = section.settings.launch_at | strip
  assign has_launch = false
  if launch_at.size == 16
    assign has_launch = true
  endif
-%}
<div class="gate gate--dark{% if section.settings.teaser and section.settings.teaser_image %} gate--teaser{% endif %}">
  <div class="gate__inner wrap">
    {%- render 'logo', tone: 'paper', class: 'gate__logo', eager: true -%}
    {%- if section.settings.teaser and section.settings.teaser_image -%}
      {%- render 'teaser', image: section.settings.teaser_image, label: section.settings.teaser_label, class: 'gate__teaser', eager: true -%}
    {%- endif -%}
    <div class="gate__text">
      <p class="gate__kicker">{{ section.settings.kicker }}</p>
      <h1 class="gate__title">{{ section.settings.title }}</h1>
      {%- if section.settings.subline != blank -%}
        <p class="gate__sub">{{ section.settings.subline }}</p>
      {%- endif -%}
      {%- if shop.password_message != blank -%}
        <p class="gate__msg">{{ shop.password_message }}</p>
      {%- endif -%}

      {%- if has_launch -%}
        <div class="gate__clock" data-launch="{{ launch_at | escape }}" hidden
          data-start-text="{{ 'azur.password.start_at' | t: date: '%DATE%', time: '%TIME%' | escape }}">
          <div class="clock" role="timer" aria-live="off" aria-label="{{ 'azur.password.clock_label' | t }}">
            <span class="clock__cell"><span class="clock__num" data-clock="d">00</span><span class="clock__unit">{{ 'azur.password.unit_d' | t }}</span></span>
            <span class="clock__sep" aria-hidden="true">:</span>
            <span class="clock__cell"><span class="clock__num" data-clock="h">00</span><span class="clock__unit">{{ 'azur.password.unit_h' | t }}</span></span>
            <span class="clock__sep" aria-hidden="true">:</span>
            <span class="clock__cell"><span class="clock__num" data-clock="m">00</span><span class="clock__unit">{{ 'azur.password.unit_m' | t }}</span></span>
            <span class="clock__sep" aria-hidden="true">:</span>
            <span class="clock__cell"><span class="clock__num" data-clock="s">00</span><span class="clock__unit">{{ 'azur.password.unit_s' | t }}</span></span>
          </div>
          <p class="clock__start" data-clock-start></p>
        </div>
      {%- endif -%}

      {%- if section.settings.signup -%}
        <div class="gate__signup">
          {%- if section.settings.signup_text != blank -%}<p class="gate__msg">{{ section.settings.signup_text }}</p>{%- endif -%}
          {%- render 'signup-form', id: 'gate', tags: 'newsletter, drops, early-access', success: section.settings.success -%}
          {%- if section.settings.early_text != blank -%}<p class="gate__early">{{ section.settings.early_text }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.instagram_url != blank -%}
        <p class="gate__social"><a class="link" href="{{ section.settings.instagram_url }}" rel="noopener" target="_blank">{{ 'azur.password.instagram' | t }}</a></p>
      {%- endif -%}
    </div>

    {%- capture password_form -%}
      {%- form 'storefront_password', class: 'gate__form' -%}
        {%- if form.errors -%}
          <p class="gate__error" role="alert">{{ 'azur.password.wrong' | t }}</p>
        {%- endif -%}
        <label class="form__label" for="gate-password">{{ 'azur.password.label' | t }}</label>
        <div class="gate__row">
          <input class="form__input" id="gate-password" type="password" name="password" autocomplete="current-password" required>
          <button class="btn btn--solid" type="submit">{{ 'general.password_page.login_password_button' | t }} <span class="arrow" aria-hidden="true">→</span></button>
        </div>
      {%- endform -%}
    {%- endcapture -%}
    {%- if section.settings.signup -%}
      <details class="gate__pw"{% if password_form contains 'gate__error' %} open{% endif %}>
        <summary class="gate__pw-head">{{ 'azur.password.have' | t }}</summary>
        {{ password_form }}
      </details>
    {%- else -%}
      {{ password_form }}
    {%- endif -%}
  </div>
</div>
{%- if has_launch -%}<script src="{{ 'azur-password.js' | asset_url }}" defer></script>{%- endif -%}

{% schema %}
{
  "name": "Passwortseite",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Zeile oben", "default": "Drop 01" },
    { "type": "text", "id": "title", "label": "Headline", "default": "Brasilien & Deutschland." },
    { "type": "text", "id": "subline", "label": "Zeile unter der Headline", "default": "Je 50 Stück. 54,99 €." },
    { "type": "header", "content": "Wecker (Countdown)" },
    { "type": "text", "id": "launch_at", "label": "Start (Datum und Uhrzeit)", "info": "Format 2027-01-15T18:00, Zeit wie in Deutschland. Der Wecker rechnet fest mit +01:00 (Winterzeit); im Sommer (Ende März bis Ende Oktober) 1 Stunde früher eintragen. Leer = kein Wecker." },
    { "type": "text", "id": "launch_tz", "label": "Zeitzone (nur Hinweis)", "default": "Europe/Berlin", "info": "Wird nicht ausgewertet. Die Zeit oben ist deutsche Ortszeit." },
    { "type": "header", "content": "Drops per Mail" },
    { "type": "checkbox", "id": "signup", "label": "Anmeldung zeigen", "default": true, "info": "Die Passworteingabe steht dann aufklappbar darunter. Tags: newsletter, drops, early-access." },
    { "type": "text", "id": "signup_text", "label": "Text über der Anmeldung", "default": "Trag dich ein. Wir wecken dich, wenn das Licht angeht." },
    { "type": "text", "id": "early_text", "label": "Vorteil für Anmelder", "info": "Leer = keine Zeile. Nur eintragen, was wirklich gilt, z. B. \"Anmelder kaufen 24 Stunden früher\"." },
    { "type": "text", "id": "success", "label": "Text nach dem Eintragen", "default": "Danke, du bist dabei. Kommt eine Bestätigungsmail, klick bitte auf den Link darin." },
    { "type": "url", "id": "instagram_url", "label": "Instagram-Link", "info": "Leer = kein Link." },
    { "type": "header", "content": "Teaser-Bild" },
    { "type": "checkbox", "id": "teaser", "label": "Teaser-Bild zeigen", "default": false },
    { "type": "image_picker", "id": "teaser_image", "label": "Bild", "info": "Ohne Bild erscheint keins." },
    { "type": "text", "id": "teaser_label", "label": "Zeile auf dem Bild", "info": "Leer = keine." }
  ]
}
{% endschema %}

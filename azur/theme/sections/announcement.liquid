{%- comment -%}
  Schwarze Leiste über dem Header, eine Zeile in Versalien. Scrollt mit der Seite weg, der Header bleibt stehen.
  Ohne eigenen Text: „Versand …“ aus Theme-Einstellungen → Azur (Versandkosten). Leer = keine Leiste.
{%- endcomment -%}
{%- liquid
  assign text = section.settings.text
  if text == blank and settings.shipping_cost != blank
    assign text = 'Versand ' | append: settings.shipping_cost
  endif
-%}
{%- if text != blank -%}
  <div class="bar">
    <p class="bar__text wrap">
      {%- if section.settings.link != blank -%}
        <a class="bar__link" href="{{ section.settings.link }}">{{ text | escape }}</a>
      {%- else -%}
        {{ text | escape }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Leiste oben",
  "class": "section-bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "info": "Leer = „Versand …“ aus Theme-Einstellungen → Azur. Nur Angaben, die im Shop so eingestellt sind." },
    { "type": "url", "id": "link", "label": "Link", "info": "Optional, z. B. die Versandseite." }
  ]
}
{% endschema %}

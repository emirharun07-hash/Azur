        for (var k in b) {
          if (b[k] && typeof b[k] === 'object' && !Array.isArray(b[k]) && a[k] && typeof a[k] === 'object') merge(a[k], b[k]);
          else a[k] = b[k];
        }
      };
      merge(c, en);

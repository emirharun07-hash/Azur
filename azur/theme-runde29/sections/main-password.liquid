{%- comment -%}
  Passwortseite, solange der Shop geschlossen ist: Teaser-Bild (Frankfurt-Trikot), zuerst die Anmeldung für Drops (E-Mail),
  darunter aufklappbar die Passworteingabe für alle, die schon ein Passwort haben.
{%- endcomment -%}
<div class="gate{% if section.settings.teaser %} gate--teaser{% endif %}">
  <div class="gate__inner wrap">
    {%- render 'logo', tone: 'paper', class: 'gate__logo', eager: true -%}
    {%- if section.settings.teaser -%}
      {%- render 'teaser', image: section.settings.teaser_image, label: section.settings.teaser_label, class: 'gate__teaser', eager: true -%}
    {%- endif -%}
    <div class="gate__text">
      <p class="gate__kicker">{{ section.settings.kicker }}</p>
      <h1 class="gate__title">{{ section.settings.title }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="gate__msg">{{ shop.password_message }}</p>
      {%- endif -%}
      {%- if section.settings.signup -%}
        <div class="gate__signup">
          {%- if section.settings.signup_text != blank -%}<p class="gate__msg">{{ section.settings.signup_text }}</p>{%- endif -%}
          {%- render 'signup-form', id: 'gate', tags: 'newsletter, drops, early-access', success: section.settings.success -%}
        </div>
      {%- endif -%}
    </div>

    {%- capture password_form -%}
      {%- form 'storefront_password', class: 'gate__form' -%}
        {%- if form.errors -%}
          <p class="gate__error" role="alert">{{ 'azur.password.wrong' | t }}</p>
        {%- endif -%}
        <label class="form__label" for="gate-password">{{ 'azur.password.label' | t }}</label>
        <div class="gate__row">
          <input class="form__input" id="gate-password" type="password" name="password" autocomplete="current-password" required>
          <button class="btn btn--solid" type="submit">{{ 'general.password_page.login_password_button' | t }} <span class="arrow" aria-hidden="true">→</span></button>
        </div>
      {%- endform -%}
    {%- endcapture -%}
    {%- if section.settings.signup -%}
      <details class="gate__pw"{% if password_form contains 'gate__error' %} open{% endif %}>
        <summary class="gate__pw-head">{{ 'azur.password.have' | t }}</summary>
        {{ password_form }}
      </details>
    {%- else -%}
      {{ password_form }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Passwortseite",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Zeile oben", "default": "Berlin 030 / Frankfurt 069" },
    { "type": "text", "id": "title", "label": "Headline", "default": "Bald." },
    { "type": "header", "content": "Drops per Mail" },
    { "type": "checkbox", "id": "signup", "label": "Anmeldung zeigen", "default": true, "info": "Die Passworteingabe steht dann aufklappbar darunter. Tags: newsletter, drops, early-access." },
    { "type": "text", "id": "signup_text", "label": "Text über der Anmeldung", "default": "Trag deine Mail ein und erfahr als Erstes, wann es losgeht." },
    { "type": "text", "id": "success", "label": "Text nach dem Eintragen", "default": "Danke, du bist dabei. Kommt eine Bestätigungsmail, klick bitte auf den Link darin." },
    { "type": "header", "content": "Teaser-Bild" },
    { "type": "checkbox", "id": "teaser", "label": "Teaser-Bild zeigen", "default": true },
    { "type": "image_picker", "id": "teaser_image", "label": "Bild", "info": "Leer = Frankfurt-Trikot von vorne, groß angeschnitten." },
    { "type": "text", "id": "teaser_label", "label": "Zeile auf dem Bild", "default": "Frankfurt 069", "info": "Leer = keine." }
  ]
}
{% endschema %}

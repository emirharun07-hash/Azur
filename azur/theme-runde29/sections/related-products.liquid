{%- comment -%}
  Weitere Trikots aus der Shop-Kollektion, ohne das aktuelle. Ab 1024 px vier nebeneinander.
{%- endcomment -%}
{%- liquid
  assign coll = settings.main_collection
  if coll.url == blank
    assign coll = collections.all
  endif
  assign shown = 0
-%}
{%- capture cards -%}
  {%- for p in coll.products -%}
    {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
    {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    {% render 'product-card', product: p, size: 'small' %}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
  <section class="rail" aria-labelledby="rail-title-{{ section.id }}">
    <header class="rail__head wrap">
      <h2 class="rail__title" id="rail-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      <a class="link rail__all" href="{{ coll.url }}">{{ 'azur.general.view_all' | t }}</a>
    </header>
    <div class="grid rail__grid wrap">{{ cards }}</div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Weitere Trikots",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Weitere Trikots" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 1, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}

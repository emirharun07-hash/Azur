{%- comment -%} Produktraster aus einer Kollektion (frei platzierbar, z. B. auf der Startseite). {%- endcomment -%}
{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = settings.main_collection
  endif
-%}
{%- if coll != blank and coll.products_count > 0 -%}
  <section class="rail" aria-labelledby="rail-title-{{ section.id }}">
    <header class="rail__head wrap">
      <h2 class="rail__title" id="rail-title-{{ section.id }}">{{ section.settings.heading | default: coll.title }}</h2>
      <a class="link rail__all" href="{{ coll.url }}">{{ 'azur.general.view_all' | t }}</a>
    </header>
    <div class="grid wrap">
      {%- for p in coll.products limit: section.settings.limit -%}
        {% render 'product-card', product: p, size: 'small' %}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Produktraster",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = Shop-Kollektion" },
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [
    { "name": "Produktraster" }
  ]
}
{% endschema %}
